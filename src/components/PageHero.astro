---
import { site } from '../lib/site';
interface Props {
  heading: string;
  intro: string;
  enquiry?: boolean;
  alternative?: { href: string; label: string };
}
const { heading, intro, enquiry = true, alternative } = Astro.props;
---

<section class="page-hero wrap">
  <h1>{heading}</h1>
  <div>
    <p>{intro}</p>
    {enquiry && (
      <a class="button" href="/contact/">
        {site.enquiry}
      </a>
    )}
    {alternative && (
      <a class="hero-alternative" href={alternative.href}>
        {alternative.label}
      </a>
    )}
  </div>
</section>
