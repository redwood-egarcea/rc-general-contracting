---
import { site } from '../lib/site';
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<section
  class="contact-reveal"
  data-contact-reveal
  aria-labelledby={`${id}-heading`}
>
  <h2 id={`${id}-heading`}>{site.contact.directHeading}</h2>
  <p>{site.contact.revealIntro}</p>
  <div class="reveal-content">
    <div class="reveal-controls" data-contact-details hidden></div>
    <button class="button secondary" type="button" data-reveal-retry hidden>
      {site.contact.revealRetry}
    </button>
    <div
      class="turnstile-slot"
      data-reveal-widget
      data-action="reveal"
      data-sitekey={import.meta.env.PUBLIC_TURNSTILE_REVEAL_SITE_KEY}
      hidden
    ></div>
    <p
      class="flow-status"
      data-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
      tabindex="-1"
    ></p>
  </div>
  <noscript>
    <p>
      {site.contact.noscript}{' '}
      <a href="/contact/#contact-alternatives">{site.contact.fallbackLink}</a>
    </p>
  </noscript>
</section>
