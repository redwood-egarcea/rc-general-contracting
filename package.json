{
  "name": "rc-general-contracting",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-static.mjs",
    "build": "astro build && node scripts/secure-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types --strict-vars=false",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write src astro.config.mjs wrangler.jsonc eslint.config.mjs package.json tsconfig.json tests playwright.config.ts",
    "format:check": "prettier --check src astro.config.mjs wrangler.jsonc eslint.config.mjs package.json tsconfig.json tests playwright.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "astro": "^7.3.4",
    "wrangler": "^4.137.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
